generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CITIZEN
  MODERATOR
  JOURNALIST
  COORDINATOR
}

enum IncidentStatus {
  DETECTED
  MODERATION
  PUBLISHED
  IN_CONTACT
  ADMIN_CONTACT
  MEASURES_ANNOUNCED
  AWAITING_RESPONSE
  RESOLVED
  ABANDONED
}

enum MacroCategory {
  ACCESSIBILITY
  NOISE
  STREET_FURNITURE
  HOUSING
  HEALTH
}

enum MediaType {
  PHOTO
  VIDEO
  AUDIO
}

enum VoteType {
  SEVERITY
  RESOLVED
}

enum ContactType {
  EMAIL
  CALL
  VISIT
  OFFICIAL_FILING
}

enum JournalisticContentType {
  VIDEO_REPORT
  ARTICLE
  DOCUMENTATION
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  name            String?
  image           String?
  role            UserRole  @default(CITIZEN)
  activityPoints  Int       @default(0)
  neighborhoodId  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  neighborhood    Neighborhood? @relation(fields: [neighborhoodId], references: [id])
  accounts        Account[]
  sessions        Session[]
  incidents       Incident[]
  votes           Vote[]
  comments        Comment[]
  follows         Follow[]
  statusChanges   StatusHistory[]
  journalisticContent JournalisticContent[]
  adminContacts   AdminContact[]

  @@index([neighborhoodId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Neighborhood {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  city        String   @default("Madrid")
  postalCode  String?
  population  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  incidents       Incident[]
  monthlyReports  MonthlyReport[]
}

model Category {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  macroCategory MacroCategory
  icon          String
  color         String

  incidents Incident[]
}

model Incident {
  id                String         @id @default(cuid())
  title             String
  description       String
  latitude          Float
  longitude         Float
  addressText       String?
  status            IncidentStatus @default(DETECTED)
  responseDeadline  DateTime?
  votesCount        Int            @default(0)
  followersCount    Int            @default(0)
  visitsCount       Int            @default(0)
  urgencyScore      Float          @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  categoryId     String
  neighborhoodId String
  authorId       String

  category      Category      @relation(fields: [categoryId], references: [id])
  neighborhood  Neighborhood  @relation(fields: [neighborhoodId], references: [id])
  author        User          @relation(fields: [authorId], references: [id])

  media              Media[]
  votes              Vote[]
  comments           Comment[]
  follows            Follow[]
  statusHistory      StatusHistory[]
  journalisticContent JournalisticContent[]
  adminContacts      AdminContact[]

  @@index([neighborhoodId])
  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@index([votesCount])
}

model Media {
  id           String    @id @default(cuid())
  incidentId   String
  type         MediaType
  url          String
  thumbnailUrl String?
  size         Int?
  duration     Int?
  createdAt    DateTime  @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model Vote {
  id         String   @id @default(cuid())
  incidentId String
  userId     String
  type       VoteType @default(SEVERITY)
  value      Int      @default(1)
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incidentId, userId, type])
  @@index([incidentId])
  @@index([userId])
}

model Comment {
  id         String   @id @default(cuid())
  incidentId String
  userId     String
  text       String
  moderated  Boolean  @default(false)
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([userId])
}

model Follow {
  id            String   @id @default(cuid())
  incidentId    String
  userId        String
  notifications Boolean  @default(true)
  createdAt     DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incidentId, userId])
  @@index([incidentId])
  @@index([userId])
}

model StatusHistory {
  id             String          @id @default(cuid())
  incidentId     String
  previousStatus IncidentStatus?
  newStatus      IncidentStatus
  authorId       String
  note           String?
  createdAt      DateTime        @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([incidentId])
}

model JournalisticContent {
  id           String                  @id @default(cuid())
  incidentId   String
  journalistId String
  type         JournalisticContentType
  title        String
  newspaperUrl String?
  contentUrl   String?
  duration     Int?
  createdAt    DateTime                @default(now())

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  journalist User     @relation(fields: [journalistId], references: [id])

  @@index([incidentId])
}

model AdminContact {
  id            String      @id @default(cuid())
  incidentId    String
  journalistId  String
  agency        String
  contactPerson String?
  contactDate   DateTime    @default(now())
  type          ContactType
  summary       String?
  response      String?
  documentUrl   String?
  createdAt     DateTime    @default(now())

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  journalist User     @relation(fields: [journalistId], references: [id])

  @@index([incidentId])
}

model MonthlyReport {
  id                String   @id @default(cuid())
  neighborhoodId    String
  month             Int
  year              Int
  summary           String?
  resolvedIncidents Int      @default(0)
  newIncidents      Int      @default(0)
  managementRanking Int?
  comparisonJson    Json?
  published         Boolean  @default(false)
  createdAt         DateTime @default(now())

  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id])

  @@unique([neighborhoodId, month, year])
  @@index([neighborhoodId])
}
